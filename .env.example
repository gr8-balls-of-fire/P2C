# Database — PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/p2c_db"

# Access Gate — API key used in all requests (P2C_ACCESS_KEY)
P2C_ACCESS_KEY="your-secret-key-here"
P2C_USER_EMAIL="your-email@example.com"

# Public environment variables (exposed to browser)
NEXT_PUBLIC_API_KEY="your-secret-key-here"
NEXT_PUBLIC_ENV="development"

# Email Sending — Resend provider (Phase 3)
RESEND_API_KEY="re_xxxxx"

# Social Integration — Buffer API (Phase 4)
BUFFER_API_KEY="buffer_token_xxxx"
