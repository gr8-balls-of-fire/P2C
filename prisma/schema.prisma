// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Venture: Multi-venture identifier (not a full tenant, just a lookup)
model Venture {
  id        String   @id @default(cuid())
  name      String
  icpNotes  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts        Contact[]
  campaigns       Campaign[]
  tasks           Task[]
  ventureContacts VentureContact[]
}

// Campaign: Groups contacts and defines custom stages for a sales campaign
model Campaign {
  id        String   @id @default(cuid())
  venture   Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  ventureId String

  name      String   // e.g., "Q4 Enterprise Push", "Startup Outreach"
  description String?

  // Custom stages for this campaign (replaces standard State enum)
  stages    CampaignStage[]
  contacts  Contact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ventureId])
}

// CampaignStage: Custom stage in a campaign's sales process
model CampaignStage {
  id        String   @id @default(cuid())
  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String

  name      String   // e.g., "Lead Qualified", "Demo Scheduled", "Proposal Sent"
  order     Int      // Stage sequence (0, 1, 2, ...)

  createdAt DateTime @default(now())

  @@unique([campaignId, name])
  @@unique([campaignId, order])
  @@index([campaignId])
}

// Contact: Core entity (Contact/Company pairing)
model Contact {
  id                String   @id @default(cuid())
  venture           Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  ventureId         String

  // Campaign (optional — if set, uses campaign's custom stages)
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId        String?

  // Contact info
  firstName         String?
  lastName          String?
  email             String?
  phone             String?
  title             String?
  company           String?
  linkedinUrl       String?
  source            String? // "manual", "csv", "api", etc.

  // Enrichment fields
  industry          String?
  companySize       String?
  notes             String?

  // Email validation
  emailVerifiedAt   DateTime?  // When email was verified/validated

  // Lifecycle state
  state             State    @default(PROSPECT)
  customStage       String?  // If in campaign, the stage name; otherwise null
  prospectState     ProspectState? // Sub-state for Prospect (used only if state=PROSPECT)

  // Tracking
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastTouchedAt     DateTime?
  nextActionDueAt   DateTime?

  stateHistory      StateHistory[]
  touches           Touch[]
  tasks             Task[]
  ventureContacts   VentureContact[]

  @@index([ventureId])
  @@index([campaignId])
  @@index([state])
  @@index([customStage])
  @@index([prospectState])
  @@index([lastTouchedAt])
  @@index([nextActionDueAt])
  @@index([emailVerifiedAt])
}

// StateHistory: Audit trail of all state transitions
model StateHistory {
  id          String   @id @default(cuid())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String

  fromState   State
  toState     State
  reason      String?  // Reason code or explanation

  createdAt   DateTime @default(now())

  @@index([contactId])
  @@index([createdAt])
}

// Touch: Record of every outbound/inbound interaction
model Touch {
  id          String   @id @default(cuid())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String

  channel     Channel
  action      String   // "email_sent", "connection_request", "dm_sent", "call_logged", etc.
  status      String   // "pending", "sent", "delivered", "opened", "replied", "failed", "logged"

  details     String?  // JSON or free text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contactId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

// Task: Daily task queue item (prospect enrichment, follow-ups, etc.)
model Task {
  id          String   @id @default(cuid())
  venture     Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  ventureId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String

  channel     Channel?  // EMAIL, LINKEDIN_DIRECT, CALL, null for system tasks
  action      String    // "enrich_prospect", "requalify", "send_email", "connect_linkedin", "follow_up_call", etc.
  status      TaskStatus @default(PENDING)  // PENDING, COMPLETED, SKIPPED, FAILED

  dueAt       DateTime
  priority    Int @default(0)  // 0 = high, 100 = low (for sorting)
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ventureId])
  @@index([contactId])
  @@index([status])
  @@index([dueAt])
  @@index([priority])
}

// VentureContact junction to track dormancy/recycling per venture
model VentureContact {
  id              String   @id @default(cuid())
  venture         Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  ventureId       String
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId       String

  touchCount      Int @default(0)  // Number of outbound touches in current cycle
  lastTouchedAt   DateTime?
  dormantAt       DateTime?  // When contact became dormant
  recycleableAt   DateTime?  // When dormant contact can be recycled (dormantAt + 90 days)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([ventureId, contactId])
  @@index([ventureId])
  @@index([contactId])
  @@index([dormantAt])
  @@index([recycleableAt])
}

// Enums
enum State {
  PROSPECT
  LEAD
  OPPORTUNITY
  CUSTOMER
  CLOSED_LOST
  DORMANT
}

enum ProspectState {
  NEW
  ENRICHED
  REQUALIFIED
  DISQUALIFIED
}

enum Channel {
  EMAIL
  LINKEDIN_DIRECT
  LINKEDIN_CONTENT
  CALL
  OTHER
}

enum TaskStatus {
  PENDING
  COMPLETED
  SKIPPED
  FAILED
}
