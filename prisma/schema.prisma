// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Venture: Multi-venture identifier (not a full tenant, just a lookup)
model Venture {
  id        String   @id @default(cuid())
  name      String
  icpNotes  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  opportunities   Opportunity[]
  campaigns       Campaign[]
  tasks           Task[]
  ventureContacts VentureContact[]
}

// Account: Company-level record
model Account {
  id              String   @id @default(cuid())
  venture         Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  ventureId       String

  name            String   // Company name
  industry        String?
  companySize     String?
  website         String?
  linkedinUrl     String?
  notes           String?

  // Venture-specific custom fields (ICP criteria)
  customFields    Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts        Contact[]
  opportunities   Opportunity[]

  @@index([ventureId])
}

// Contact: Person at an Account
model Contact {
  id              String   @id @default(cuid())
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId       String

  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  title           String?  // Job title
  linkedinUrl     String?
  source          String?  // "manual", "csv", "api"

  // Email validation
  emailVerifiedAt DateTime?

  // Contact-specific custom fields (role, influence, etc.)
  customFields    Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  opportunityContacts OpportunityContact[]
  touches         Touch[]
  tasks           Task[]

  @@index([accountId])
  @@index([email])
  @@index([emailVerifiedAt])
}

// Opportunity: Sales process / Deal
model Opportunity {
  id              String   @id @default(cuid())
  venture         Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  ventureId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId       String
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId      String?

  name            String   // "Acme Inc - ArcAI License"
  description     String?
  amount          Float?   // Deal value

  // Core lifecycle state machine
  state           State    @default(PROSPECT)
  prospectState   ProspectState?
  customStage     String?  // If in campaign, the custom stage name

  // Stakeholders involved in this opportunity
  contacts        OpportunityContact[]

  // Tracking
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastTouchedAt   DateTime?
  nextActionDueAt DateTime?

  // Deal-specific custom fields
  customFields    Json?

  stateHistory    StateHistory[]
  touches         Touch[]
  tasks           Task[]
  ventureOpps     VentureContact[]

  @@index([ventureId])
  @@index([accountId])
  @@index([campaignId])
  @@index([state])
  @@index([customStage])
  @@index([prospectState])
  @@index([lastTouchedAt])
  @@index([nextActionDueAt])
}

// OpportunityContact: Many-to-many (Opportunity has many Contacts)
model OpportunityContact {
  id            String   @id @default(cuid())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId     String

  // Role in this deal
  role          String?  // "champion", "economic_buyer", "technical_eval"

  createdAt     DateTime @default(now())

  @@unique([opportunityId, contactId])
  @@index([opportunityId])
  @@index([contactId])
}

// Campaign: Groups opportunities and defines custom stages
model Campaign {
  id        String   @id @default(cuid())
  venture   Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  ventureId String

  name      String
  description String?

  stages    CampaignStage[]
  opportunities Opportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ventureId])
}

// CampaignStage: Custom stage in a campaign
model CampaignStage {
  id        String   @id @default(cuid())
  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String

  name      String
  order     Int

  createdAt DateTime @default(now())

  @@unique([campaignId, name])
  @@unique([campaignId, order])
  @@index([campaignId])
}

// StateHistory: Audit trail of all state transitions
model StateHistory {
  id          String   @id @default(cuid())
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String

  fromState   State
  toState     State
  reason      String?

  createdAt   DateTime @default(now())

  @@index([opportunityId])
  @@index([createdAt])
}

// Touch: Record of every outbound/inbound interaction
model Touch {
  id          String   @id @default(cuid())
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String?

  channel     Channel
  action      String
  status      String

  details     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([opportunityId])
  @@index([contactId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

// Task: Daily task queue item
model Task {
  id          String   @id @default(cuid())
  venture     Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  ventureId   String
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String?

  channel     Channel?
  action      String
  status      TaskStatus @default(PENDING)

  dueAt       DateTime
  priority    Int @default(0)
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ventureId])
  @@index([opportunityId])
  @@index([contactId])
  @@index([status])
  @@index([dueAt])
  @@index([priority])
}

// VentureContact: Dormancy tracking per venture
model VentureContact {
  id              String   @id @default(cuid())
  venture         Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  ventureId       String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId   String

  touchCount      Int @default(0)
  lastTouchedAt   DateTime?
  dormantAt       DateTime?
  recycleableAt   DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([ventureId, opportunityId])
  @@index([ventureId])
  @@index([opportunityId])
  @@index([dormantAt])
  @@index([recycleableAt])
}

// Enums
enum State {
  PROSPECT
  LEAD
  OPPORTUNITY
  CUSTOMER
  CLOSED_LOST
  DORMANT
}

enum ProspectState {
  NEW
  ENRICHED
  REQUALIFIED
  DISQUALIFIED
}

enum Channel {
  EMAIL
  LINKEDIN_DIRECT
  LINKEDIN_CONTENT
  CALL
  OTHER
}

enum TaskStatus {
  PENDING
  COMPLETED
  SKIPPED
  FAILED
}
